# Contoh konfigurasi. Salin jadi .env lalu isi nilai rahasia sendiri.
# .env asli TIDAK pernah masuk git (lihat .gitignore).

# ==========================================
# AI CRYPTO FUTURES TRADING BOT CONFIGURATION
# ==========================================

# 1. Trading Execution Mode: 'paper' | 'testnet' | 'live'
# Disarankan mulai dengan 'paper' untuk memvalidasi sinyal AI & strategi
TRADING_MODE=live

# 2. Binance API Credentials (REAL LIVE)
BINANCE_LIVE_API_KEY=your_binance_live_api_key
BINANCE_LIVE_API_SECRET=your_binance_live_api_secret

# 2.1 Binance API Credentials (DEMO MOCK)
BINANCE_DEMO_API_KEY=your_binance_demo_api_key
BINANCE_DEMO_API_SECRET=your_binance_demo_api_secret

# Fallback default
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# 3. AI Brain Configuration
# Opsi 1: Google Gemini API langsung (https://aistudio.google.com/)
# GEMINI_API_KEY=<removed>
#GEMINI_MODEL=gemini-2.5-flash-lite

# Opsi 2: 9router / OmniRoute / OpenRouter (OpenAI-compatible)
# Ubah AI_PROVIDER menjadi 'omniroute' atau '9router' jika ingin menggunakannya
AI_PROVIDER=9router
AI_BASE_URL=https://your-ai-endpoint/v1
AI_API_KEY=your_ai_provider_api_key
AI_MODEL=ag/gemini-3-flash

# 4. Trading Settings (Futures)
# Kosongkan agar 100% GET dinamis dari Binance Scanner (Tidak perlu diisi manual!)
# Atau isi koin tertentu jika ingin mengunci koin spesifik (contoh: XAU/USDT)
TRADING_SYMBOLS=
TIMEFRAME=15m
LEVERAGE=5
MARGIN_TYPE=ISOLATED

# 5. Risk Management Guardrails
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_LOSS_PCT=0.05
MAX_OPEN_POSITIONS=3
MIN_RISK_REWARD_RATIO=1.5
MIN_AI_CONFIDENCE=0.85

# 6. Saldo Awal Virtual (Hanya untuk TRADING_MODE=paper)
PAPER_INITIAL_BALANCE=1000.0

# 7. Interval Pengecekan (menit)
CHECK_INTERVAL_MINUTES=5

# 8. Notifikasi Telegram (Opsional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
AUTO_START_BOT=false
AI_REQUEST_TIMEOUT=90.0
MEMORY_GUARD_MIN_SAMPLE=15

# TP1 target (exit 50% posisi) - diubah operator
TP1_TARGET_PCT=0.05
MAX_EXPOSURE_MULT=2.0
AI_VOLUME_HOLD_ENABLED=true
POSITION_SCALING_LOW=1.0
TP_ROTATION_ENABLED=true
MIN_QUANT_SCORE=62.0
QUANT_WEIGHT=0.70
AI_WEIGHT=0.30
MIN_ENTRY_VOL_RATIO=1.0
HARD_REJECT_CONSOLIDATION=false
HARD_GATE_VOLUME=true
EDGE_ALLOW_BULLISH_FALLBACK=false
AI_CAUTION_MIN_CONFIDENCE=0.75

# Blokir TradFi perps (XAU/emas, saham tokenized) dari scanner - diaktifkan operator 2026-10-14
SCAN_BLACKLIST_TRADFI=true


# Strategy A (TP lebar + anti-churn) — applied by operator 2026-10-14
TRAILING_START_PCT=0.03
MAX_DAILY_ENTRIES=3
MIN_GRID_STEP_PCT=0.015
# Simbol dikelola operator manual (ladder) — bot tidak adopt/manage
MANUAL_SYMBOLS=
ENTRY_ENABLED=true

# Hard gate enforced by auto_pilot_trader.py
MIN_AI_CONF=0.85

# --- strategy knobs (commented = default; uncomment only with 30+ closed trades) ---
# STRAT_MIN_VOL_RATIO=1.0
# STRAT_SL_ATR=2.0
# STRAT_TP1_R=2.0
# STRAT_TP2_R=3.5
# STRAT_BE_AT_R=1.0
# STRAT_COMPRESSION_Q=0.25
# STRAT_BREAK_LOOKBACK=20
# RISK_USDT=0.30
# DAILY_CAP_SEC=86400
STRAT_TP1_R=1.0
STRAT_TP2_R=2.0
RISK_USDT=0
RISK_MAX_USDT=0
CIRCUIT_BREAKER_MAX_LOSS=5.00

# --- universe dinamis (bukan parameter strategi) ---
SCAN_MODE=market
SCAN_MIN_VOL_USDT=20000000
SCAN_PRE_RANK=50

# --- ranking kandidat: pita volume surge ---
SCAN_RANK_MODE=band
SCAN_VOL_BAND_CENTER=1.4
# Filter konfirmasi volume bar 4h (0 = mati / rollback)
MIN_VOLR_4H=0.6
