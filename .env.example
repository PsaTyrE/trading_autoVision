# ==========================================
# AI CRYPTO FUTURES TRADING BOT CONFIGURATION
# ==========================================

# 1. Trading Execution Mode
# Options: 'paper' (virtual money simulation), 'testnet' (Binance Futures Testnet), 'live' (Real Binance Futures)
TRADING_MODE=live

# 2. Binance API Credentials
# Bisa menggunakan satu pasang key, atau memisahkan LIVE dan DEMO (Testnet)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# 3. AI Engine Configuration (9router / OmniRoute / OpenAI / Gemini)
AI_PROVIDER=9router
AI_BASE_URL=
AI_API_KEY=your_ai_api_key_here
AI_MODEL=auto-models

# 4. Market & Execution Settings
# Kosongkan TRADING_SYMBOLS agar scanner auto-pick Asymmetric Alpha Binance 100% dinamis!
TRADING_SYMBOLS=
QUOTE_ASSET=USDT
TIMEFRAME=15m
LEVERAGE=5
MARGIN_TYPE=ISOLATED
DEFAULT_INVESTMENT=50.0
GRID_COUNT=8

# 5. 3 Pilar Disiplin Trading & Risk Management Guardrails
# Pilar 1: Batas transaksi harian & Circuit Breaker kerugian harian
MAX_DAILY_TRADES=30
MAX_DAILY_LOSS_PCT=0.05

# Pilar 2 & 3: Validasi batas margin per trade, rasio R:R, & batas notional Binance
MAX_RISK_PER_TRADE=0.02
MAX_MARGIN_PER_TRADE_PCT=0.35
MIN_RISK_REWARD_RATIO=1.5
MIN_AI_CONFIDENCE=0.70
MIN_NOTIONAL_THRESHOLD=5.50
TAKER_FEE_RATE=0.0004
MAX_OPEN_POSITIONS=3

# 6. Saldo Awal Simulasi (Hanya untuk TRADING_MODE=paper)
PAPER_INITIAL_BALANCE=1000.0

# 7. Interval Pengecekan Analisis (dalam menit)
CHECK_INTERVAL_MINUTES=15

# 8. Notifikasi Telegram (Opsional, kosongkan jika belum punya)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
