import json
import os
import re
from typing import Dict, Any, Optional
from pydantic import BaseModel, Field
from src.config import config

def _price_decimals(price: float) -> int:
    """Reasonable decimal places for a price when no exchange tick is available."""
    try:
        p = float(price or 0.0)
    except Exception:
        return 4
    if p <= 0:
        return 4
    if p < 0.001:
        return 8
    if p < 0.01:
        return 6
    if p < 0.1:
        return 5
    if p < 1.0:
        return 4
    if p < 100.0:
        return 3
    return 2

class TradeSignal(BaseModel):
    action: str = Field(description="Action to take: LONG, SHORT, or HOLD")
    confidence: float = Field(description="Confidence level between 0.0 and 1.0")
    suggested_entry: Optional[float] = Field(default=None, description="Recommended entry price")
    stop_loss: Optional[float] = Field(default=None, description="Strict stop-loss price level")
    take_profit_1: Optional[float] = Field(default=None, description="First take-profit target")
    take_profit_2: Optional[float] = Field(default=None, description="Extended take-profit target")
    recommended_leverage: Optional[int] = Field(default=5, description="Recommended leverage multiplier")
    risk_reward_ratio: Optional[float] = Field(default=0.0, description="Calculated Risk to Reward ratio")
    primary_reason: str = Field(description="Detailed trading rationale based on indicators and price action")
    risk_factors: list[str] = Field(default_factory=list, description="Identified risk factors or invalidation points")


class AIAnalyzer:
    def __init__(self):
        self.provider = config.ai_provider
        self.api_key = config.ai_api_key or config.gemini_api_key
        self.base_url = config.ai_base_url.rstrip("/") if config.ai_base_url else ""
        self.model_name = config.ai_model or "auto-models"
        # AUDIT FIX: 9router (and similar local routers) reject the API key when hit
        # via the LAN IP ("API key required for remote API access") but accept it on
        # localhost. If the configured base_url is a LAN/host address, add the localhost
        # twin as a fallback so a remote-auth rejection or a router restart on the LAN
        # never silently drops the AI brain to the rule engine.
        self._base_urls = [self.base_url] if self.base_url else []
        try:
            import urllib.parse as _up
            if self.base_url:
                _u = _up.urlsplit(self.base_url)
                _host = _u.hostname or ""
                if _host and _host not in ("127.0.0.1", "localhost", "::1"):
                    _lh = _up.urlunsplit((_u.scheme, "127.0.0.1" + (f":{_u.port}" if _u.port else ""), _u.path, "", ""))
                    if _lh not in self._base_urls:
                        self._base_urls.append(_lh)
        except Exception:
            pass

        self.client = None

        # Check if using OpenAI-compatible gateway (OmniRoute, 9router, OpenRouter, etc.)
        self.is_openai_compatible = bool(self.base_url or self.provider in ["omniroute", "9router", "openai", "openrouter"])

        if not self.is_openai_compatible and self.api_key and self.api_key not in ["your_gemini_api_key_here", ""]:
            try:
                from google import genai
                self.client = genai.Client(api_key=self.api_key)
            except Exception as e:
                try:
                    import google.generativeai as legacy_genai
                    legacy_genai.configure(api_key=self.api_key)
                    self.client = legacy_genai.GenerativeModel(self.model_name)
                except Exception as e2:
                    print(f"[!] Could not initialize Gemini AI: {e2}")

    def analyze_market(self, market_snapshot: Dict[str, Any]) -> TradeSignal:
        """
        Takes technical market context and queries AI for decision making.
        Supports OpenAI-compatible routers (OmniRoute, 9router) with multi-model fallback cascade & native Gemini.
        Falls back to built-in Quant Rule Engine if all AI models are offline or out of quota.
        """
        if self.is_openai_compatible and self.api_key:
            try:
                return self._analyze_with_openai_compatible(market_snapshot)
            except Exception as e:
                print(f"[!] OpenAI/Router request error: {e}. Falling back to Rule-Based Quant Engine.")
                return self._fallback_rule_engine(market_snapshot)

        if self.client:
            try:
                return self._analyze_with_gemini(market_snapshot)
            except Exception as e:
                print(f"[!] Gemini AI request error: {e}. Falling back to Rule-Based Quant Engine.")
                return self._fallback_rule_engine(market_snapshot)

        return self._fallback_rule_engine(market_snapshot)

    @staticmethod
    def _loads_lenient(text: str) -> Dict[str, Any]:
        """Parse JSON that LLM routers often emit with trailing commas, unescaped
        control chars, or trailing junk after the first object (a stray 'data: [DONE]'
        or a second concatenated object). Try strict, then cleaned, then decode just
        the FIRST object so a trailing artifact cannot force a silent fallback to the
        rule engine (which drops the AI brain)."""
        try:
            return json.loads(text)
        except json.JSONDecodeError:
            cleaned = re.sub(r",\s*([}\]])", r"\1", text)          # drop trailing commas
            cleaned = re.sub(r"[\x00-\x1f]", " ", cleaned)          # strip raw control chars
            try:
                return json.loads(cleaned)
            except json.JSONDecodeError:
                # Decode the first complete JSON value; ignore any trailing junk.
                return json.JSONDecoder().raw_decode(cleaned.lstrip())[0]

    def _analyze_with_openai_compatible(self, snapshot: Dict[str, Any]) -> TradeSignal:
        import requests
        prompt = self._build_prompt(snapshot)
        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json"
        }

        model = self.model_name
        payload = {
            "model": model,
            "messages": [
                {
                    "role": "system",
                    "content": "You are an Elite Crypto Quantitative Futures Trader. You must respond ONLY in strict, valid JSON matching the schema."
                },
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.1,
            "stream": False
        }

        # AI routers can be slow under load; a short timeout causes silent fallback
        # to the raw rule-engine (losing the AI brain). P0: 10.0s timeout (env-overridable).
        ai_timeout = float(os.getenv("AI_REQUEST_TIMEOUT", str(getattr(config, "ai_request_timeout", 45.0))))
        # AUDIT FIX: iterate the base_url fallback list (primary + localhost twin). A
        # remote-access rejection (HTTP 401/403) or connection error on one host moves
        # to the next instead of dropping straight to the rule engine.
        _bases = self._base_urls or [self.base_url]
        _last_err = None
        resp = None
        for _base in _bases:
            _endpoint = f"{_base}/chat/completions" if "/chat/completions" not in _base else _base
            try:
                resp = requests.post(_endpoint, headers=headers, json=payload, timeout=ai_timeout)
                if resp.status_code == 200:
                    break
                _last_err = f"HTTP {resp.status_code} on {_endpoint}: {resp.text[:200]}"
                resp = None
            except Exception as _e:
                _last_err = f"{_endpoint}: {_e}"
                resp = None
        if resp is None:
            raise Exception(f"9router unreachable on all base URLs ({_last_err})")

        # Safely extract main JSON object, ignoring any trailing 'data: [DONE]' from proxy routers
        text = resp.text.strip()
        start_idx = text.find("{")
        end_idx = text.rfind("}")
        if start_idx != -1 and end_idx != -1:
            text = text[start_idx:end_idx + 1]

        res_json = self._loads_lenient(text)
        # AUDIT FIX: a router error object (e.g. {"error": ...}) has no 'choices' and used
        # to crash the whole AI path, silently degrading to the rule engine. Fail loudly
        # with a clear message so the hybrid engine logs a real reason.
        try:
            raw_text = res_json["choices"][0]["message"]["content"].strip()
        except (KeyError, IndexError, TypeError) as e:
            raise Exception(f"9router returned an unusable payload on model {model}: {str(res_json)[:200]}") from e

        # Extract inner JSON if the AI model output markdown fences or commentary
        inner_start = raw_text.find("{")
        inner_end = raw_text.rfind("}")
        if inner_start != -1 and inner_end != -1:
            raw_text = raw_text[inner_start:inner_end + 1]

        data = self._loads_lenient(raw_text)

        # Normalize action
        act = str(data.get("action", "HOLD")).upper()
        if "BUY" in act or "LONG" in act:
            data["action"] = "LONG"
        elif "SELL" in act or "SHORT" in act:
            data["action"] = "SHORT"
        else:
            data["action"] = "HOLD"

        if "confidence" not in data or not isinstance(data["confidence"], (int, float)):
            # AUDIT FIX: do not fabricate a confidence. If the AI omitted it, force HOLD
            # (the hybrid engine then routes to QUANT_FAILOVER) unless config says otherwise.
            if bool(getattr(config, "ai_missing_confidence_hold", True)):
                data["action"] = "HOLD"
                data["confidence"] = 0.0
            else:
                data["confidence"] = float(getattr(config, "ai_default_confidence", 0.65))
        if "primary_reason" not in data or not data["primary_reason"]:
            data["primary_reason"] = f"Market analysis from 9router ({model})"

        return TradeSignal(**data)




    def _build_prompt(self, snapshot: Dict[str, Any]) -> str:
        curr_price = float(snapshot.get("current_price", 0.0) or 0.0)
        precision = 7 if 0 < curr_price < 0.001 else (6 if curr_price < 0.01 else (5 if curr_price < 0.1 else (4 if curr_price < 1.0 else 2)))

        # AUDIT FIX: expose the real round-trip cost so the AI's requested RR is net-of-cost.
        # Prefer the LIVE taker fee injected into the snapshot (Binance VIP-tier aware); fall back
        # to config only when the live rate is unavailable — never silently UNDER-state the cost.
        _live_fee = None
        try:
            _lf = (snapshot.get("fees") or {}).get("taker_fee_rate")
            _live_fee = float(_lf) if _lf is not None else None
        except Exception:
            _live_fee = None
        if _live_fee and _live_fee > 0:
            _rt_fee = _live_fee * 2.0  # round-trip: entry + exit both pay taker
        else:
            _rt_fee = max(float(getattr(config, "taker_fee_rate", 0.0004)) * 2.0,
                          float(getattr(config, "taker_fee_rate", 0.0004)) + float(getattr(config, "maker_fee_rate", 0.0002)))
        _round_trip_cost_pct = (_rt_fee + float(getattr(config, "expected_slippage_pct", 0.0005))) * 100.0
        _conf_lo = float(getattr(config, "ai_conf_floor", 0.50))
        _conf_hi = float(getattr(config, "max_ai_confidence", 0.99))

        # Rule 3 volume clause is toggleable: when disabled, low volume alone is NOT a veto
        # (it aligns the AI with the validated edge). The trend/MACD contradiction clause
        # ALWAYS applies. Config-driven so the behaviour is env-overridable, never hardcoded.
        _vol_hold = bool(getattr(config, "ai_volume_hold_enabled", True))
        if _vol_hold:
            _rule3 = '3. CONTRADICTION & LIQUIDITY FILTER: If Trend and MACD status disagree, or volume_condition is "LOW_VOLUME_DANGER", output "HOLD".'
        else:
            _rule3 = ('3. CONTRADICTION FILTER: If Trend and MACD status disagree, output "HOLD". '
                      'A low volume_condition ("LOW_VOLUME_DANGER") is NOT by itself a veto — the validated '
                      'statistical edge lives in low-volume NEUTRAL/consolidation regimes, so judge low volume '
                      'as a sizing/slippage consideration, not an automatic HOLD.')

        # 1. Extract Quant Math Pre-Calculations if provided
        quant_info = snapshot.get("quant_math_evaluation")
        quant_section = ""
        if quant_info:
            reasons_bullets = "\n".join([f"    • {r}" for r in quant_info.get("reasons", [])])
            quant_section = f"""
===================================================================
TRIAD PILLAR 2: QUANT MATH ENGINE PRE-CALCULATIONS
===================================================================
• Mathematical Bullish Score : {quant_info.get('score')}/100 ({quant_info.get('action')})
• Calculated Volatility      : {quant_info.get('volatility_pct')}%
• Structural Stop-Loss Floor : ${quant_info.get('recommended_stop_loss')}
• Optimal Grid Spacing Count : {quant_info.get('recommended_grid_count')} lines
• Quant Profit Multiplier    : {quant_info.get('profit_multiplier', 1.0)}x
• Mathematical Audit Points  :
{reasons_bullets}
"""

        # 2. Extract Self-Learning Memory Lessons & Pattern Match
        memory_lessons = snapshot.get("self_learning_lessons")
        memory_synergy = snapshot.get("memory_synergy")
        memory_section = ""
        if memory_lessons or memory_synergy:
            syn_info = ""
            if memory_synergy:
                if memory_synergy.get("is_penalized"):
                    syn_info = f"\n  ⚠️ MEMORY WARNING: Setup matches past Stop-Loss failure by {memory_synergy.get('match_pct')}% ({memory_synergy.get('reason')}). Enforce defensive mode!"
                elif memory_synergy.get("alpha_boost", 0) > 0:
                    syn_info = f"\n  🎯 MEMORY CATALYST: Setup matches past high-profit trade by {memory_synergy.get('match_pct')}% ({memory_synergy.get('boost_reason')}). High-profit potential!"

            memory_section = f"""
===================================================================
TRIAD PILLAR 3: SELF-LEARNING EPISODIC MEMORY (LESSONS & EXPERIENCE)
===================================================================
{memory_lessons or 'Discipline Active: No active penalty.'}{syn_info}
"""

        # 3. Clean snapshot copy for JSON display without duplicating large sub-dicts
        display_snap = {k: v for k, v in snapshot.items() if k not in ["quant_math_evaluation", "self_learning_lessons", "memory_synergy"]}

        return f"""
