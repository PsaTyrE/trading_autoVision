}}
"""



    def _analyze_with_gemini(self, snapshot: Dict[str, Any]) -> TradeSignal:
        prompt = self._build_prompt(snapshot)

        # Prioritize flash-lite models for generous 1500 req/day quota
        models_to_try = [

            "gemini-2.5-flash-lite",
            self.model_name,
            "gemini-flash-latest"
        ]
        # Remove duplicates while preserving order
        unique_models = []
        for m in models_to_try:
            if m and m not in unique_models:
                unique_models.append(m)

        last_err = None

        for model in unique_models:
            for attempt in range(2):
                try:
                    if hasattr(self.client, "chats"):
                        from google.genai import types
                        gen_config = types.GenerateContentConfig(
                            temperature=0.1,
                            response_mime_type="application/json"
                        )
                        chat_session = self.client.chats.create(model=model)
                        response = chat_session.send_message(
                            message=prompt,
                            config=gen_config
                        )
                        text = response.text.strip()
                    else:
                        response = self.client.generate_content(prompt)
                        text = response.text.strip()

                    # Clean markdown fences if any
                    text = re.sub(r"^```json\s*", "", text, flags=re.IGNORECASE)
                    text = re.sub(r"^```\s*", "", text)
                    text = re.sub(r"\s*```$", "", text)

                    data = json.loads(text)
                    return TradeSignal(**data)
                except Exception as e:
                    last_err = e
                    err_msg = str(e)
                    # If quota exhausted (429), don't retry same model - break and try next model immediately
                    if "429" in err_msg or "RESOURCE_EXHAUSTED" in err_msg:
                        break
                    # If temporary 503 high demand spike, brief backoff
                    if "503" in err_msg or "UNAVAILABLE" in err_msg:
                        import time
                        time.sleep(1.5)
                    continue

        raise last_err or Exception("All Gemini models failed")





    def _fallback_rule_engine(self, snapshot: Dict[str, Any]) -> TradeSignal:
        """
        Built-in algorithmic rule engine when Gemini API is not yet plugged in or offline.
        Uses EMA Trend, RSI, MACD Cross, and ATR.
        """
        price = snapshot.get("current_price", 0.0)
        trend = snapshot.get("trend_bias", "BULLISH")
        indicators = snapshot.get("indicators", {})
        rsi = indicators.get("rsi_14", 50.0)
        macd = indicators.get("macd", {})
        macd_status = macd.get("status", "BULLISH_CROSS") if isinstance(macd, dict) else "BULLISH_CROSS"
        atr = indicators.get("atr_14", price * 0.02)
        vol_ratio = indicators.get("volume_vs_average", 1.0)

        # Default HOLD
        action = "HOLD"
        confidence = 0.50
        sl = price
        tp1 = price
        tp2 = price
        rr = 0.0
        reason = "Market in consolidation or awaiting clearer confirmation."
        risks = ["Waiting for high-confidence catalyst"]

        # Bullish setup:
        # Trend is BULLISH, RSI between 40 and 65 (not overbought), MACD not in death cross, good volume
        if trend == "BULLISH" and 42 <= rsi <= 68 and macd_status != "BEARISH_CROSS" and vol_ratio >= 0.8:
            action = "LONG"
            confidence = float(getattr(config, "fallback_ai_confidence", 0.78))
            _prec = _price_decimals(price)
            sl = round(price - (atr * float(getattr(config, "fallback_sl_atr_mult", 1.8))), _prec)
            tp1 = round(price + (atr * float(getattr(config, "fallback_tp1_atr_mult", 2.8))), _prec)
            tp2 = round(price + (atr * float(getattr(config, "fallback_tp2_atr_mult", 4.2))), _prec)
            denom = price - sl
            rr = round((tp1 - price) / denom, 2) if denom > 0 else 1.5
            reason = f"Bullish trend confirmed (Price > EMA20 > EMA50). RSI at {rsi} has upward room. Volume healthy ({vol_ratio}x avg)."
            risks = ["Sudden pullback below EMA50"]

        # Bearish setup:
        # Trend is BEARISH, RSI between 32 and 58 (not oversold), MACD not in golden cross
        elif trend == "BEARISH" and 32 <= rsi <= 58 and macd_status != "BULLISH_CROSS" and vol_ratio >= 0.8:
            action = "SHORT"
            confidence = float(getattr(config, "fallback_ai_confidence", 0.78))
            _prec = _price_decimals(price)
            sl = round(price + (atr * float(getattr(config, "fallback_sl_atr_mult", 1.8))), _prec)
            tp1 = round(price - (atr * float(getattr(config, "fallback_tp1_atr_mult", 2.8))), _prec)
            tp2 = round(price - (atr * float(getattr(config, "fallback_tp2_atr_mult", 4.2))), _prec)
            denom = sl - price
            rr = round((price - tp1) / denom, 2) if denom > 0 else 1.5
            reason = f"Bearish trend confirmed (Price < EMA20 < EMA50). RSI at {rsi} shows downward momentum."
            risks = ["Short squeeze potential at major support"]


        return TradeSignal(
            action=action,
            confidence=confidence,
            suggested_entry=price,
            stop_loss=sl,
            take_profit_1=tp1,
            take_profit_2=tp2,
            recommended_leverage=config.leverage,
            risk_reward_ratio=rr,
            primary_reason=reason,
            risk_factors=risks
        )
