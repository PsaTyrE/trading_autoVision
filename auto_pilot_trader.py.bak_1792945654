def log_close_if_flat(t, st):
    """CLOSE_LOG: reconcile a finished trade into trade_closed.csv with net USDT and R."""
    at = st.get("active_trade")
    if not at:
        return
    try:
        with contextlib.redirect_stdout(sys.stderr):
            live = [p for p in t.exchange.fetch_positions() if float(p.get("contracts") or 0) != 0]
    except Exception as e:
        log(f"close-log positions error: {e}")
        return  # never book a close on a failed read
    if live:
        return
    raw = str(at["symbol"]).split(":")[0].replace("/", "")
    pnl = fee = 0.0
    n_tr = 0
    try:
        with contextlib.redirect_stdout(sys.stderr):
            for x in t.exchange.fapiPrivateGetUserTrades({"symbol": raw, "limit": 100}):
                # CLOSE_WINDOW: ts is stamped after protection placement, i.e. a few
                # seconds AFTER the fill. A strict >= filter excluded the entry fill.
                if int(x["time"]) >= (int(at["ts"]) - 600) * 1000:
                    pnl += float(x["realizedPnl"])
                    fee += float(x["commission"])
                    n_tr += 1
    except Exception as e:
        log(f"close-log fetch error: {e}")
    if n_tr == 0:
        log(f"close-log: no fills for {raw} since entry - not booking, retry next run")
        return
    net = pnl - fee
    risk = float(at.get("risk") or 0.0)
    r = net / risk if risk else 0.0
    try:
        import csv
        new = not os.path.exists(CLOSED)
        with open(CLOSED, "a", newline="") as f:
            w = csv.writer(f)
            if new:
                w.writerow(["ts", "symbol", "side", "entry", "qty", "gross", "fee", "net", "risk", "R"])
            w.writerow([int(time.time()), at["symbol"], at["side"], at["entry"], at["qty"],
                        round(pnl, 4), round(fee, 4), round(net, 4), risk, round(r, 2)])
    except Exception as e:
        log(f"close-log write error: {e}")
    st["active_trade"] = None
    save_state(st)
    log(f"CLOSED {at['symbol']} {at['side']} gross={pnl:+.4f} fee={fee:.4f} net={net:+.4f} R={r:+.2f}")
    try:
        TelegramNotifier().send_message(
            f"<b>[CLOSED]</b> {at['symbol']} {at['side']}\n"
            f"Entry ${at['entry']} qty {at['qty']}\n"
            f"Gross <b>{pnl:+.4f}</b> | Fee {fee:.4f} | Net <b>{net:+.4f} USDT</b> | <b>{r:+.2f}R</b>")
    except Exception as e:
        log(f"Telegram notify error: {e}")

def manage_open_positions(t):
    """Monitor live positions, update trailing stop / break-even."""
    with contextlib.redirect_stdout(sys.stderr):
        positions = [p for p in t.exchange.fetch_positions() if float(p.get("contracts") or 0) != 0]

    if not positions:
        return None

    pos = positions[0]
    symbol = pos["symbol"]
    qty = abs(float(pos["contracts"]))
    entry = float(pos["entryPrice"])
    # SIDE_FIX: ccxt returns contracts as a POSITIVE size and puts direction in
    # pos["side"]. Sign-testing contracts read every SHORT as LONG, so the trail
    # would arm a stop on the wrong side of price.
    side = "LONG" if str(pos.get("side", "")).lower() in ("long", "buy") else "SHORT"
    
    with contextlib.redirect_stdout(sys.stderr):
        tk = t.exchange.fetch_ticker(symbol)
        algos = t.get_conditional_orders(symbol)

    cur_price = float(tk["last"])
    pnl_pct = (cur_price - entry) / entry if side == "LONG" else (entry - cur_price) / entry

    # Adaptive R-based trailing: 1R -> breakeven, 2R -> trail 0.5R behind price
    dec = 2 if "XAU" not in symbol else 1
    # SHORT_SL_PICK: a SHORT stop sits ABOVE price, so max() returned the FURTHEST
    # stop -> r_dist overstated -> 1R/2R never reached -> trailing never armed.
    stops = [float(a.get("triggerPrice") or a.get("stopPrice") or 0.0) for a in algos
             if "STOP" in (a.get("orderType") or "").upper()]
    stops = [x for x in stops if x > 0]
    if side == "LONG":
        cand = [x for x in stops if x < cur_price] or stops
        cur_sl = max(cand) if cand else 0.0
    else:
        cand = [x for x in stops if x > cur_price] or stops
        cur_sl = min(cand) if cand else 0.0
    r_dist = abs(entry - cur_sl) if cur_sl else 0.0
    gain = (cur_price - entry) if side == "LONG" else (entry - cur_price)

    lock_sl = None
    if r_dist > 0:
        if gain >= r_dist * 2.0:
            lock_sl = round(cur_price - r_dist * 0.5, dec) if side == "LONG" else round(cur_price + r_dist * 0.5, dec)
        elif gain >= r_dist * 1.0:
            lock_sl = round(entry * 1.001, dec) if side == "LONG" else round(entry * 0.999, dec)

    # HEARTBEAT: manage-only runs used to print nothing, so a healthy bot with an
    # open position looked dead in the log.
    log(f"HB {symbol} {side} qty {qty} px {cur_price} pnl {pnl_pct*100:+.2f}% "
        f"gainR {gain/r_dist if r_dist else 0:.2f} sl {cur_sl or 0}")

    if lock_sl:
        # TRAIL_EPS: 0.1 was a PRICE unit. On DOGE/SUI/WIF (~$0.2) that is ~50% of
        # price, so the trail could never move. Epsilon must scale with price.
        eps = max(abs(cur_price) * 1e-4, 10.0 ** -dec)
        should_update = (side == "LONG" and lock_sl > cur_sl + eps) or \
                        (side == "SHORT" and (cur_sl == 0 or lock_sl < cur_sl - eps))
        if should_update:
            log(f"Trailing: Locking profit on {symbol} -> Moving SL to {lock_sl}")
            with contextlib.redirect_stdout(sys.stderr):
                t.set_protective_stop(symbol, lock_sl, amount=qty, position_side=side)
            try:
                msg = f"🔒 <b>[PROFIT LOCKED / TRAILING SL]</b>\nSymbol: <b>{symbol}</b> ({side})\nPrice: <b>${cur_price}</b> | SL Rapat: <b>${lock_sl}</b>\nStatus: Profit terkunci, sisa posisi anti-minus!"
                TelegramNotifier().send_message(msg)
            except Exception as e:
                log(f"Telegram notify error: {e}")

    return symbol

# --- MAKER ENTRY (the only real fee lever at this account size) --------------
# Taker 0.05% x2 = $0.046/round-trip on a ~$46 notional = 16% of a $0.29 risk.
# Post-only maker 0.02% x2 = $0.018. Saves $0.027/trade and drops the breakeven
# winrate from 30.8% to 28.3% -- decisive for a 23-34% winrate system.
MAKER_TIMEOUT_SEC = 90
MAKER_POLL_SEC = 5
MAKER_MAX_SLIP_ATR = 0.25


def maker_entry(t, sym, side, qty, ref_price, atr):
    """Post-only at the touch. Never chases: abandons if price runs off."""
    oid = None
    try:
        book = t.exchange.fetch_order_book(sym, limit=5)
        side_book = book["bids"] if side == "BUY" else book["asks"]
        if not side_book:
            return None
        px = float(t.exchange.price_to_precision(sym, side_book[0][0]))
        o = t._submit_order(symbol=sym, type="limit", side=side.lower(), amount=qty,
                            price=px, params={"postOnly": True, "timeInForce": "GTX"})
        if not o:
            return None
        oid = o.get("id")
        deadline = time.time() + MAKER_TIMEOUT_SEC
        while time.time() < deadline:
            time.sleep(MAKER_POLL_SEC)
            try:
                o = t.exchange.fetch_order(oid, sym)
            except Exception:
                continue
            if o.get("status") in ("closed", "filled"):
                log(f"MAKER FILL {sym} {side} {qty} @ {o.get('average') or px} (0.02% fee)")
                return o
            cur = float(t.exchange.fetch_ticker(sym)["last"])
            slip = (cur - ref_price) if side == "BUY" else (ref_price - cur)
            if slip > MAKER_MAX_SLIP_ATR * atr:
                log(f"MAKER ABANDON {sym}: price ran {slip:.4f} > {MAKER_MAX_SLIP_ATR}xATR - no chase")
                break
        try:
            t.exchange.cancel_order(oid, sym)
        except Exception:
            pass
        # MAKER_RECHECK: cancel fails BECAUSE the order just filled. Returning None
        # there left a real position with no stop, no journal row, no state.
        try:
            o = t.exchange.fetch_order(oid, sym)
            if o.get("status") in ("closed", "filled") or float(o.get("filled") or 0) > 0:
                log(f"MAKER FILL (late) {sym} {side} {qty} @ {o.get('average') or px}")
                return o
        except Exception:
            pass
        log(f"MAKER NOT FILLED {sym} after {MAKER_TIMEOUT_SEC}s - signal dropped, no market chase")
        return None
    except Exception as e:
        log(f"MAKER ERROR {sym}: {e}")
        if oid:
            try:
                t.exchange.cancel_order(oid, sym)
            except Exception:
                pass
        return None


def scan_and_enter(t):
    """COMPRESSION BREAKOUT v2 - 4h volatility squeeze -> expansion, both directions.

    Measured: no edge vs matched random over ~3,000 sim trades (9 families tried).
    Runs as a capped experiment: fixed $ risk, 1 trade/day, hard equity breaker, journaled.
    """
    # --- NEWS GUARD ---
    try:
        res = ForexFactoryNewsSentinel().check_news_guard()
        if res.get("is_danger", False):
            ev = res.get("imminent_event")
            log(f"NEWS GUARD: {ev.get('title') if ev else 'high-impact event'}. Entries paused.")
            return
    except Exception as e:
        log(f"News guard error: {e}")

    # --- BALANCE ---
    try:
        with contextlib.redirect_stdout(sys.stderr):
            usdt = t.exchange.fetch_balance()["USDT"]
        free = float(usdt.get("free") or 0.0)
        equity = float(usdt.get("total") or 0.0)
    except Exception as e:
        log(f"Balance fetch error: {e}")
        return
    if free < 10.0:
        log(f"Capital too low (free ${free:.2f}) - no entry")
        return

    # --- CIRCUIT BREAKER ---
    try:
        bp = "/home/pi/latihan/.equity_baseline"
        if not os.path.exists(bp):
            open(bp, "w").write(f"{equity:.6f}")
        base = float(open(bp).read().strip())
        if equity < base - 1.50:
            log(f"CIRCUIT BREAKER: equity ${equity:.2f} < ${base:.2f}-1.50. Entries halted.")
            return
    except Exception as e:
        log(f"Breaker error: {e}")

    # --- POSITION LIMIT CHECK ---
    try:
        with contextlib.redirect_stdout(sys.stderr):
            _open_pos = [p for p in t.exchange.fetch_positions() if float(p.get("contracts") or 0) != 0]
        if len(_open_pos) >= MAX_OPEN_POSITIONS:
            log(f"Max positions ({MAX_OPEN_POSITIONS}) reached ({len(_open_pos)} open) - skip scan")
            return
    except Exception as e:
        log(f"Pos check error: {e}")

    # --- DAILY CAP ---
    st = load_state() or {}
    if time.time() - float(st.get("last_entry_ts", 0)) < DAILY_CAP_SEC:
        log("Daily cap reached (1 trade/24h). Waiting.")
        return

    # --- SCAN CLOSED 4h BARS ---
    def _tradeable(sym, meta):
        """False kalau risk $0.30 tidak bisa dibulatkan ke batas exchange."""
        sd = strategy.SL_ATR * meta["atr"]
        if sd <= 0:
            return False
        raw_q = RISK_USDT / sd
        m = t.exchange.market(sym)
        min_q = float(m["limits"]["amount"]["min"] or 0)
        min_c = float(m["limits"]["cost"]["min"] or 0)
        if raw_q < min_q:
            return False
        if raw_q * meta["close"] < max(MIN_NOTIONAL, min_c):
            return False
        return True

    # MULTI-POS: collect top N candidates sorted by score
    candidates = []
    for sym in WATCHLIST:
        try:
            with contextlib.redirect_stdout(sys.stderr):
                raw = t.exchange.fetch_ohlcv(sym, timeframe=strategy.TF, limit=320)
            if len(raw) < strategy.MIN_BARS:
                continue
            d = strategy.features(pd.DataFrame(raw, columns=["t", "o", "h", "l", "c", "v"]))
            sig = strategy.signal(d, -2)          # last CLOSED bar
            if not sig:
                continue
            side, meta = sig
            if st.get("last_signal_ts") == meta["bar_ts"]:
                continue
            if not _tradeable(sym, meta):
                log(f"Skip {sym}: qty/notional below exchange minimum")
                continue
            candidates.append((sym, side, meta, meta["vol_ratio"]))
        except Exception as e:
            log(f"scan {sym}: {type(e).__name__}: {str(e)[:120]}")
            continue

    # Sort by vol_ratio desc and keep top MAX_OPEN_POSITIONS
    candidates.sort(key=lambda x: x[3], reverse=True)
    candidates = candidates[:MAX_OPEN_POSITIONS]

    if not candidates:
        log("No compression-breakout signal on last closed 4h bar.")
        return

    # MULTI-POS: process each candidate
    for idx, (sym, side, meta, _) in enumerate(candidates):
        action = "buy" if side == "BUY" else "sell"
        side_str = "LONG" if side == "BUY" else "SHORT"
        resolved = t.resolve_symbol(sym)
        with contextlib.redirect_stdout(sys.stderr):
            price = float(t.exchange.fetch_ticker(resolved)["last"])

        sl_dist = strategy.SL_ATR * meta["atr"]
        if sl_dist <= 0 or price <= 0:
            continue
        try:
            qty = float(t.exchange.amount_to_precision(resolved, RISK_USDT / sl_dist))
        except Exception as e:
            log(f"Skip {sym}: qty precision ({e})")
            continue
        if qty <= 0:
            log(f"qty=0 for {sym} (sl_dist {sl_dist:.6f})")
            continue
        notional = qty * price
        if notional < MIN_NOTIONAL:
            log(f"Skip {sym}: notional ${notional:.2f} < ${MIN_NOTIONAL} (stop too wide)")
            continue
        max_notional = free * MAX_MARGIN_PCT * MAX_LEVERAGE
        if notional > max_notional:
            qty = float(t.exchange.amount_to_precision(resolved, max_notional / price))
            notional = qty * price
            if qty <= 0:
                continue

    # --- AI VETO (direction disagreement only) ---
    ai_reason = "n/a"
    try:
        snap = {"symbol": sym, "current_price": price, "action": side_str,
                "trend": "4h",
                "trend_bias": "BULLISH" if meta.get("trend_up") else "BEARISH",
                "volume_ratio": round(meta["vol_ratio"], 2),
                "volume_condition": "high" if meta["vol_ratio"] >= 1.5 else "normal",
                "score": meta.get("score", 50),
                "breakout_margin_pct": round(meta.get("breakout_margin", 0.0) / price * 100, 3),
                "indicators": {"rsi_14": round(meta.get("rsi", 50.0), 1),
                               "atr_14": round(meta["atr"], 6),
                               "volume_vs_average": round(meta["vol_ratio"], 2)}}
        ai_res = AIAnalyzer().analyze_market(snap)
        ai_reason = ai_res.primary_reason
        log(f"AI {sym}: {ai_res.action} vs {side_str} conf {ai_res.confidence:.2f} | {ai_reason}")
        if ai_res.confidence < MIN_AI_CONF:
            log(f"VETO: AI confidence {ai_res.confidence:.2f} < {MIN_AI_CONF} on {sym}")
            return
        if ai_res.action in ("LONG", "SHORT") and ai_res.action != side_str:
            log(f"VETO: AI disagrees ({ai_res.action} vs {side_str})")
            return
    except Exception as ae:
        # AI_FAILCLOSED: SOP forbids entering without AI validation. An AI outage
        # used to wave the trade through; now it blocks the entry.
        log(f"VETO: AI unavailable ({ae}) - no entry without analysis")
        return

    # --- EXECUTE (maker, never chase) ---
    with contextlib.redirect_stdout(sys.stderr):
        t.exchange.set_leverage(MAX_LEVERAGE, resolved)
        order = maker_entry(t, resolved, action, qty, price, meta["atr"])
    if not order:
        log(f"Entry skipped on {sym}: maker unfilled")
        return

    time.sleep(1)
    fill = float(order.get("average") or order.get("price") or price)
    sl, tp1, tp2, _ = strategy.levels(fill, meta["atr"], side)
    px = lambda x: float(t.exchange.price_to_precision(resolved, x))
    sl_price, tp1_price, tp2_price = px(sl), px(tp1), px(tp2)
    close_side = "sell" if side == "BUY" else "buy"

    # POST_FILL_GUARD: an exception here used to kill main() and leave a real
    # position with no stop until the 5-min safety net noticed.
    stop_ok = False
    try:
        with contextlib.redirect_stdout(sys.stderr):
            stop_ok = bool(t.set_protective_stop(sym, sl_price, amount=qty, position_side=side_str))
    except Exception as se:
        log(f"STOP PLACEMENT ERROR {sym}: {se}")
    if not stop_ok:
        log(f"NO STOP on {sym} - emergency flatten (capital preservation)")
        try:
            with contextlib.redirect_stdout(sys.stderr):
                t.close_position(sym)
        except Exception as ce:
            log(f"Emergency close failed {sym}: {ce}")
        try:
            TelegramNotifier().send_message(
                f"\u26a0\ufe0f <b>ENTRY DIBATALKAN</b> {sym} {side_str}\n"
                f"Stop gagal dipasang - posisi ditutup darurat. Cek manual!")
        except Exception:
            pass
        st["last_entry_ts"] = time.time()
        st["last_signal_ts"] = meta["bar_ts"]
        save_state(st)
        return
    try:
        with contextlib.redirect_stdout(sys.stderr):
            tp1_qty = float(t.exchange.amount_to_precision(resolved, qty * 0.5))
            tp2_qty = float(t.exchange.amount_to_precision(resolved, qty - tp1_qty))
            if tp1_qty > 0:
                t.place_limit_order(sym, close_side, tp1_qty, tp1_price, reduce_only=True)
            if tp2_qty > 0:
                t.place_limit_order(sym, close_side, tp2_qty, tp2_price, reduce_only=True)
    except Exception as te:
        log(f"TP placement error {sym} (stop is live, continuing): {te}")

    st["last_entry_ts"] = time.time()
    st["last_signal_ts"] = meta["bar_ts"]
    save_state(st)

    risk_real = qty * sl_dist
    fee_rt = notional * 0.001
    # CLOSE_LOG: without this the bot never learns a trade ended, so the kill
    # rule (30 closed trades, sum R <= 0) could never be evaluated.
    # FILL_PRICE: state/journal/alert used the pre-fill ticker, not the actual fill.
    st["active_trade"] = {"symbol": sym, "side": side_str, "entry": fill, "qty": qty,
                          "sl": sl_price, "ts": int(time.time()), "risk": round(risk_real, 4)}
    save_state(st)
    try:
        import csv
        new = not os.path.exists(JOURNAL)
        with open(JOURNAL, "a", newline="") as f:
            w = csv.writer(f)
            if new:
                w.writerow(["ts", "symbol", "side", "entry", "qty", "notional", "sl", "tp1",
                            "tp2", "sl_pct", "risk_usdt", "fee_rt", "atr", "vol_ratio", "reason"])
            w.writerow([int(time.time()), sym, side_str, fill, qty, round(notional, 2),
                        sl_price, tp1_price, tp2_price, round(sl_dist / price * 100, 2),
                        round(risk_real, 4), round(fee_rt, 4), round(meta["atr"], 6),
                        round(meta["vol_ratio"], 2), ai_reason])
    except Exception as je:
        log(f"Journal error: {je}")

    log(f"ENTRY {sym} {side_str} qty={qty} @ {fill} notional=${notional:.2f} "
        f"SL={sl_price} TP1={tp1_price} TP2={tp2_price} risk=${risk_real:.2f} "
        f"fee_rt=${fee_rt:.4f} ({fee_rt/risk_real*100:.1f}% of risk)")

    try:
        TelegramNotifier().notify_trade_opened(sym, {
            "action": side_str, "entry_price": fill, "stop_loss": sl_price,
            "take_profit_1": f"{tp1_price} (50%) & {tp2_price} (50%)",
            "leverage": MAX_LEVERAGE,
            "required_margin_usdt": round(notional / MAX_LEVERAGE, 2),
            "risk_amount_usdt": round(risk_real, 2),
            "risk_pct": f"{sl_dist / price * 100:.2f}%",
        }, f"Compression breakout 4h | vol {meta['vol_ratio']:.2f}x | {ai_reason}", mode="live")
    except Exception as tge:
        log(f"Telegram notify error: {tge}")


def run():
    with contextlib.redirect_stdout(sys.stderr):
        t = BinanceFuturesTrader(is_testnet=False)

    st = load_state()
    log_close_if_flat(t, st)

    active_symbol = manage_open_positions(t)
    if not active_symbol:
        if os.getenv("ENTRY_ENABLED", "false").lower() in ("1", "true", "yes", "on"):
            scan_and_enter(t)
        else:
            log("ENTRY PAUSED (ENTRY_ENABLED=false) - manage-only mode")


def main():
    # MAIN_GUARD: an unhandled exception used to die silently in cron stderr and
    # the next run repeated it 2 minutes later with nobody told.
    try:
        run()
    except Exception as e:
        import traceback
        log(f"FATAL {type(e).__name__}: {e}")
        print(traceback.format_exc()[-800:], file=sys.stderr, flush=True)
        try:
            TelegramNotifier().send_message(
                f"\u274c <b>BOT ERROR</b>\n<code>{type(e).__name__}: {str(e)[:200]}</code>\n"
                f"Run berikutnya otomatis coba lagi.")
        except Exception:
            pass
        sys.exit(1)

if __name__ == "__main__":
    main()
