def log(msg):
    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}", flush=True)

def load_state():
    try:
        return json.load(open(STATE_FILE))
    except Exception:
        return {"active_trade": None, "last_scan": 0}

def save_state(s):
    # ATOMIC_STATE: a truncated write (kill / power loss) made load_state() fall
    # back to {} and silently forget last_entry_ts -> the 24h cap was bypassed.
    tmp = STATE_FILE + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(s, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, STATE_FILE)
    except Exception as e:
        log(f"state write error: {e}")

